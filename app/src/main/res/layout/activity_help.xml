<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_world_map"
    android:orientation="vertical"
    tools:context=".HelpActivity">

    <include layout="@layout/view_toolbar" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <com.google.android.material.card.MaterialCardView
            style="?attr/materialCardViewElevatedStyle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="16dp"
            app:cardBackgroundColor="@color/surface_translucent"
            app:cardCornerRadius="20dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="20dp"
                android:paddingBottom="20dp">

                <TextView
                    style="@style/HelpSectionTitle"
                    android:text="@string/help_goal_title" />

                <TextView
                    style="@style/HelpSectionBody"
                    android:text="@string/help_goal_body" />

                <TextView
                    style="@style/HelpSectionTitle"
                    android:text="@string/help_play_title" />

                <TextView
                    style="@style/HelpSectionBody"
                    android:text="@string/help_play_body" />

                <TextView
                    style="@style/HelpSectionTitle"
                    android:text="@string/help_score_title" />

                <TextView
                    style="@style/HelpSectionBody"
                    android:text="@string/help_score_body" />

                <TextView
                    style="@style/HelpSectionTitle"
                    android:text="@string/help_history_title" />

                <TextView
                    style="@style/HelpSectionBody"
                    android:text="@string/help_history_body" />

                <TextView
                    style="@style/HelpSectionTitle"
                    android:text="@string/help_settings_title" />

                <TextView
                    style="@style/HelpSectionBody"
                    android:text="@string/help_settings_body" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </ScrollView>

</LinearLayout>
